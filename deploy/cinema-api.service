[Unit]
Description=Cinema Namayesh API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cinema
Group=cinema
WorkingDirectory=/srv/cinema-namayesh/current/apps/api
EnvironmentFile=/etc/cinema-namayesh/api.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cinema-namayesh

[Install]
WantedBy=multi-user.target
