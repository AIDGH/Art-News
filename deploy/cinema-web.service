[Unit]
Description=Cinema Namayesh Web
After=network-online.target cinema-api.service
Wants=network-online.target
Requires=cinema-api.service

[Service]
Type=simple
User=cinema
Group=cinema
WorkingDirectory=/srv/cinema-namayesh/current/apps/web
EnvironmentFile=/etc/cinema-namayesh/web.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3001
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/cinema-namayesh/releases

[Install]
WantedBy=multi-user.target
