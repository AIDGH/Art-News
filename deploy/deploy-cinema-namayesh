#!/usr/bin/env bash
set -Eeuo pipefail

SOURCE_DIR=/srv/cinema-namayesh/source
RELEASES_DIR=/srv/cinema-namayesh/releases
CURRENT_LINK=/srv/cinema-namayesh/current
STATE_DIR=/var/lib/cinema-namayesh
DEPLOYED_REVISION_FILE="$STATE_DIR/deployed-revision"
LOCK_FILE=/run/lock/cinema-namayesh-deploy.lock

exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

git -C "$SOURCE_DIR" fetch --quiet --prune origin main
target_revision="$(git -C "$SOURCE_DIR" rev-parse origin/main)"
deployed_revision="$(cat "$DEPLOYED_REVISION_FILE" 2>/dev/null || true)"

if [[ "$target_revision" == "$deployed_revision" ]]; then
  exit 0
fi

release_dir="$RELEASES_DIR/$target_revision"
previous_release=""
if [[ -L "$CURRENT_LINK" ]]; then
  previous_release="$(readlink -f "$CURRENT_LINK" 2>/dev/null || true)"
fi

if [[ ! -d "$release_dir" ]]; then
  git -C "$SOURCE_DIR" worktree add --detach "$release_dir" "$target_revision"
fi

ln -sfn "$STATE_DIR/uploads" "$release_dir/apps/web/public/uploads"

cd "$release_dir"
corepack pnpm install --frozen-lockfile
set -a
source /etc/cinema-namayesh/api.env
set +a
corepack pnpm api:prisma:generate
corepack pnpm --filter @art-news/api exec prisma migrate deploy
chown cinema:cinema "$STATE_DIR/cinema.db"
chmod 0660 "$STATE_DIR/cinema.db"
corepack pnpm api:build
set -a
source /etc/cinema-namayesh/web.env
set +a
corepack pnpm web:build
setfacl -R -m u:cinema:rX "$release_dir"
chown -R cinema:cinema "$release_dir/apps/web/.next/cache"

ln -sfn "$release_dir" "$CURRENT_LINK.new"
mv -Tf "$CURRENT_LINK.new" "$CURRENT_LINK"
systemctl restart cinema-api.service cinema-web.service

if ! curl --fail --silent --show-error --retry 10 --retry-delay 2 \
  http://127.0.0.1:4001/api/v1/health >/dev/null || \
  ! curl --fail --silent --show-error --retry 10 --retry-delay 2 \
  http://127.0.0.1:3001/ >/dev/null; then
  if [[ -n "$previous_release" && -d "$previous_release" ]]; then
    ln -sfn "$previous_release" "$CURRENT_LINK.new"
    mv -Tf "$CURRENT_LINK.new" "$CURRENT_LINK"
    systemctl restart cinema-api.service cinema-web.service
  fi
  exit 1
fi

printf '%s\n' "$target_revision" > "$DEPLOYED_REVISION_FILE"
chown cinema:cinema "$DEPLOYED_REVISION_FILE"

mapfile -t old_releases < <(find "$RELEASES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -rn | tail -n +4 | cut -d' ' -f2-)
for old_release in "${old_releases[@]}"; do
  git -C "$SOURCE_DIR" worktree remove --force "$old_release"
done
