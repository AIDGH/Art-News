generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  AUTHOR
  EDITOR
  ADMIN
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum HomepageSlot {
  LEAD
  SECONDARY
  EDITORS_PICK
  SECTION_FEATURE
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  displayName  String
  passwordHash String
  role         UserRole  @default(AUTHOR)
  articles     Article[]
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  description String?
  sortOrder   Int       @default(0)
  articles    Article[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
}

model Article {
  id                 String              @id @default(uuid())
  slug               String              @unique
  title              String
  lead               String
  body                String
  status              PublicationStatus   @default(DRAFT)
  seoTitle            String?
  seoDescription      String?
  publishedAt         DateTime?            @db.Timestamptz(6)
  authorId            String
  categoryId          String
  coverImageId        String?
  author              User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverImage          MediaAsset?           @relation("ArticleCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  tags                ArticleTag[]
  sources             ArticleSource[]
  homepagePlacements  HomepagePlacement[]
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6)

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([authorId])
}

model Tag {
  id        String       @id @default(uuid())
  slug      String       @unique
  title     String       @unique
  articles  ArticleTag[]
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model MediaAsset {
  id              String    @id @default(uuid())
  kind            MediaKind @default(IMAGE)
  url             String
  mimeType        String
  width           Int?
  height          Int?
  alt             String
  credit          String?
  caption         String?
  focalPointX     Float?
  focalPointY     Float?
  coveredArticles Article[] @relation("ArticleCover")
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
}

model ArticleSource {
  id          String    @id @default(uuid())
  articleId   String
  url         String
  title       String?
  publisher   String?
  author      String?
  publishedAt DateTime? @db.Timestamptz(6)
  accessedAt  DateTime  @default(now()) @db.Timestamptz(6)
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model HomepagePlacement {
  id           String       @id @default(uuid())
  articleId    String
  slot         HomepageSlot
  displayOrder Int          @default(0)
  startsAt     DateTime?     @db.Timestamptz(6)
  endsAt       DateTime?     @db.Timestamptz(6)
  article      Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([articleId, slot])
  @@index([slot, displayOrder])
}
