generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  AUTHOR
  EDITOR
  ADMIN
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum HomepageSlot {
  LEAD
  SECONDARY
  EDITORS_PICK
  SECTION_FEATURE
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  displayName  String
  passwordHash String
  role         UserRole  @default(AUTHOR)
  articles     Article[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  description String?
  sortOrder   Int       @default(0)
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id                 String              @id @default(uuid())
  slug               String              @unique
  title              String
  lead               String
  body               String
  status             PublicationStatus   @default(DRAFT)
  seoTitle           String?
  seoDescription     String?
  publishedAt        DateTime?
  authorId           String
  categoryId         String
  coverImageId       String?
  author             User                @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverImage         MediaAsset?         @relation("ArticleCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  tags               ArticleTag[]
  sources            ArticleSource[]
  homepagePlacements HomepagePlacement[]
  comments           ArticleComment[]
  likes              ArticleLike[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([authorId])
}

model ArticleComment {
  id          String        @id @default(uuid())
  articleId   String
  authorName  String
  body        String
  visitorId   String
  status      CommentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  moderatedAt DateTime?
  article     Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  likes       CommentLike[]

  @@index([articleId, status, createdAt])
  @@index([status, createdAt])
  @@index([visitorId, createdAt])
}

model ArticleLike {
  id        String   @id @default(uuid())
  articleId String
  visitorId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, visitorId])
}

model CommentLike {
  id        String         @id @default(uuid())
  commentId String
  visitorId String
  createdAt DateTime       @default(now())
  comment   ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, visitorId])
}

model Tag {
  id        String       @id @default(uuid())
  slug      String       @unique
  title     String       @unique
  articles  ArticleTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model MediaAsset {
  id              String    @id @default(uuid())
  kind            MediaKind @default(IMAGE)
  url             String
  mimeType        String
  width           Int?
  height          Int?
  alt             String
  credit          String?
  caption         String?
  focalPointX     Float?
  focalPointY     Float?
  coveredArticles Article[] @relation("ArticleCover")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ArticleSource {
  id          String    @id @default(uuid())
  articleId   String
  url         String
  title       String?
  publisher   String?
  author      String?
  publishedAt DateTime?
  accessedAt  DateTime  @default(now())
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model HomepagePlacement {
  id           String       @id @default(uuid())
  articleId    String
  slot         HomepageSlot
  displayOrder Int          @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  article      Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([articleId, slot])
  @@index([slot, displayOrder])
}

model SiteSettings {
  id                String   @id @default("site")
  footerDescription String
  aboutBody         String
  updatedAt         DateTime @updatedAt
}
